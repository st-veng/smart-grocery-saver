# Copy to .env. All values here are safe local-dev defaults.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://sgs:sgs@localhost:5433/sgs_dev
# Base URL for tests; each test package creates its own database from it (sgs_test_<pkg>).
DATABASE_URL_TEST=postgres://sgs:sgs@localhost:5433/sgs_test
DATABASE_URL_E2E=postgres://sgs:sgs@localhost:5433/sgs_e2e
JWT_SECRET=dev-only-change-me-dev-only-change-me
COOKIE_SECURE=false
# Google OAuth: leave blank to use the local mock consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
AUTH_GOOGLE_MODE=mock
PRICE_PROVIDER=mock
METRO=DFW
SEED=20261116
# Blank = today in America/Chicago. Tests pin 2026-11-01.
SEED_ANCHOR_DATE=
FUEL_CENTS_PER_GAL_DEFAULT=279
PRESELECT_RADIUS_MILES=7
# Main St & Preston Rd, Frisco TX
DEFAULT_ORIGIN=33.1500,-96.8065
DEMO_USER_PASSWORD=demo-password-123
